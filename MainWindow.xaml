<Window x:Class="WpfArrayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Робота з масивом" Height="300" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Кількість елементів n:" VerticalAlignment="Center"/>
            <TextBox x:Name="InputN" Width="60" Margin="10,0,0,0"/>
            <Button Content="Згенерувати" Click="GenerateArray_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="ArrayList" Grid.Row="1" Height="150"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
            <Button Content="Знайти суму" Click="CalcSum_Click" Margin="0,0,10,0"/>
            <Button Content="Впорядкувати після мінімального" Click="SortAfterMin_Click"/>
        </StackPanel>

        <TextBlock x:Name="ResultText" Grid.Row="3" FontWeight="Bold" FontSize="14"/>
    </Grid>
</Window>
